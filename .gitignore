# ---------------------------------------------------------------------------------------------
# Claude Desktop Companion - what must NEVER be committed
# ---------------------------------------------------------------------------------------------

# ---- personal configuration and data (the app keeps these in %USERPROFILE%\.claude-notifier) ----
.claude-notifier/
/ntfy.json
/settings.json
**/ntfy.json
**/settings.json
usage-state.json
history.db
history.db-*
history.jsonl
notifier.lock
# the example templates in docs/examples are the only *.json configuration files that may be committed
!docs/examples/ntfy.example.json
!docs/examples/settings.example.json

# ---- logs, transcripts, crash dumps ----
*.log
*.log.*
logs/
*.dmp
*.stackdump
transcripts/
*.jsonl

# ---- secrets and signing material (a code-signing key must NEVER be in the repository) ----
*.pfx
*.p12
*.pem
*.key
*.jks
*.keystore
*.snk
*.pvk
*.spc
*.cer
*.crt
*.der
.env
.env.*
*.secret
*.secrets
secrets.*
signing.config.json
signing-*.json
credentials*.json
*.token
# SimplySign / eSigner / HSM client configuration and caches
SimplySign*/
eSigner*/
CodeSignTool*/

# ---- build and test output (generated; recreate with the scripts) ----
/release/stage/
/release/stage.building/
/release/*.exe
/release/*.zip
/installer/out/
/installer/out-test/
/installer/work/
/installer-test/
/win-test*/
/qr-test*/
/*-test*/
/src/tools/x-out/
/src/tools/*-out/
*.exe
*.msi
*.zip
*.7z
*.nupkg
# local copy of the Inno Setup compiler and downloaded installers (never commit tool installers)
/tools/
# screenshots taken by the test suites and scratch work
/theme-screenshots/
/shots/
/scratch/
/tmp/
*.tmp
*.bak
*.orig
*.rej
*.swp
*.x
_final.sh

# ---- Node / editor / OS ----
node_modules/
npm-debug.log*
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
